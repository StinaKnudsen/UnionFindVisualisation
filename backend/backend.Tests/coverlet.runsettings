<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Only measure the backend assembly -->
          <Include>[backend]*</Include>
          <!-- Exclude auto-generated migration files -->
          <ExcludeByFile>**/Migrations/**/*.cs</ExcludeByFile>
          <!-- Exclude classes decorated with generated-code attributes -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
